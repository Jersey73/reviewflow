# Public Supabase configuration used by browser/server auth and public business lookup
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=

# SERVER ONLY — never prefix with NEXT_PUBLIC_ and never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# SERVER ONLY
GEMINI_API_KEY=

# Admin access is managed through Supabase Auth + public.admin_users.
# Do not put admin credentials in environment variables.
